#!/usr/bin/env bash
# Committed: bash review-package PLAN_FILE BASE HEAD [OUTFILE]
# Uncommitted: bash review-package PLAN_FILE BASE --working-tree -- PATH...
# PATHs are literal repo-relative task scopes; no index or HEAD writes.
set -euo pipefail
export GIT_OPTIONAL_LOCKS=0

usage() {
  echo 'usage: review-package PLAN_FILE BASE HEAD [OUTFILE]' >&2
  echo '   or: review-package PLAN_FILE BASE --working-tree -- PATH...' >&2
  exit 2
}
[ "$#" -ge 3 ] || usage
plan=$1
[ -f "$plan" ] || { echo "no such plan file: $plan" >&2; exit 2; }
base=$(git rev-parse --verify --quiet "$2^{commit}") || { echo "bad BASE: $2" >&2; exit 2; }
scriptdir=$(cd "$(dirname "$0")" && pwd)
canonical_path() {
  local value
  value=$(realpath -m -- "$1")
  if command -v cygpath >/dev/null 2>&1; then
    value=$(cygpath -u "$(cygpath -am "$value")")
  fi
  printf '%s\n' "$value"
}
root=$(canonical_path "$(git rev-parse --show-toplevel)")

if [ "$3" != '--working-tree' ]; then
  [ "$#" -le 4 ] || usage
  head=$(git rev-parse --verify --quiet "$3^{commit}") || { echo "bad HEAD: $3" >&2; exit 2; }
  if [ "$#" -eq 4 ]; then
    out=$4
  else
    dir=$(bash "$scriptdir/sdd-workspace" "$plan")
    out="$dir/review-${base:0:7}..${head:0:7}.diff"
  fi
  {
    printf '# Review package\n\nMode: committed\nBase: %s\nHead: %s\n' "$base" "$head"
    printf '\n## Commits\n'
    git log --oneline "$base..$head"
    printf '\n## Files changed\n'
    git diff --stat "$base..$head"
    printf '\n## Diff\n'
    git diff --no-ext-diff --no-textconv --binary -U10 "$base..$head"
  } > "$out"
else
  [ "$#" -ge 5 ] && [ "$4" = '--' ] || usage
  shift 4
  paths=()
  specs=()
  for scope in "$@"; do
    [ -n "$scope" ] || { echo 'empty task path' >&2; exit 2; }
    case "$scope" in :*) echo 'Git pathspec magic is not a literal task path' >&2; exit 2 ;; esac
    case "$scope" in /*|[A-Za-z]:/*) target=$scope ;; *) target="$root/$scope" ;; esac
    target=$(canonical_path "$target")
    case "$target" in "$root"/*) relative=${target#"$root"/} ;; *) echo "path outside task repository: $scope" >&2; exit 2 ;; esac
    case "$relative" in .git|.git/*) echo 'Git metadata is not a task path' >&2; exit 2 ;; esac
    spec=":(literal)$relative"
    if [ ! -e "$target" ] && [ -z "$(git -C "$root" ls-files -- "$spec")" ] && [ -z "$(git -C "$root" ls-tree -r --name-only "$base" -- "$relative")" ]; then
      echo "task path does not exist in worktree, index or BASE: $scope" >&2
      exit 2
    fi
    paths+=("$relative")
    specs+=("$spec")
  done
  dir=$(bash "$scriptdir/sdd-workspace" "$plan")
  digest=$(printf '%s\0' "${paths[@]}" | git hash-object --stdin)
  out="$dir/review-working-tree-${base:0:7}-${digest:0:12}.diff"
  {
    printf '# Review package\n\nMode: working-tree\nBase: %s\nHead observed: %s\n' "$base" "$(git rev-parse HEAD)"
    printf '\n## Literal task paths\n'
    printf '%s\n' "${paths[@]}"
    printf '\n## Status (staged and unstaged)\n'
    git -C "$root" status --short --untracked-files=all -- "${specs[@]}"
    printf '\n## Tracked files changed from BASE\n'
    git -C "$root" diff --stat "$base" -- "${specs[@]}"
    printf '\n## Tracked net diff from BASE (index and working tree)\n'
    git -C "$root" diff --no-ext-diff --no-textconv --binary -U10 "$base" -- "${specs[@]}"
    printf '\n## Untracked additions\n'
    while IFS= read -r -d '' file; do
      printf '\n### %s\n' "$file"
      result=0
      git -C "$root" diff --no-index --no-ext-diff --no-textconv --binary -U10 -- /dev/null "$file" || result=$?
      [ "$result" -le 1 ] || exit "$result"
    done < <(git -C "$root" ls-files --others --exclude-standard -z -- "${specs[@]}")
  } > "$out"
fi
printf 'wrote %s: %s bytes\n' "$out" "$(wc -c < "$out" | tr -d ' ')"
