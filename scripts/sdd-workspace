#!/usr/bin/env bash
# Resolve artifacts for a plan; legacy directories require proven journal identity.
# Usage: bash sdd-workspace PLAN_FILE
set -euo pipefail

[ "$#" -eq 1 ] || { echo 'usage: sdd-workspace PLAN_FILE' >&2; exit 2; }
[ -f "$1" ] || { echo "no such plan file: $1" >&2; exit 2; }
canonical_path() {
  local value
  value=$(realpath -m -- "$1")
  if command -v cygpath >/dev/null 2>&1; then
    value=$(cygpath -u "$(cygpath -am "$value")")
  fi
  printf '%s\n' "$value"
}
root=$(canonical_path "$(git rev-parse --show-toplevel)")
plan=$(canonical_path "$1")
case "$plan" in "$root"/*) relative=${plan#"$root"/} ;; *) echo 'plan must be inside the repository' >&2; exit 2 ;; esac
slug=$(basename "$plan" .md)
[ -n "$slug" ] && [ "$slug" != '.' ] && [ "$slug" != '..' ] || { echo 'invalid plan name' >&2; exit 2; }

matches_identity() {
  local first identity candidate
  [ -f "$1/progress.md" ] || return 1
  IFS= read -r first < "$1/progress.md" || [ -n "$first" ]
  first=${first%$'\r'}
  case "$first" in
    '# SDD ledger: plan: '*) identity=${first#'# SDD ledger: plan: '} ;;
    '# SDD ledger — plan: '*) identity=${first#'# SDD ledger — plan: '} ;;
    *) return 1 ;;
  esac
  [ -n "$identity" ] || return 1
  case "$identity" in /*|[A-Za-z]:/*) candidate=$identity ;; *) candidate="$root/$identity" ;; esac
  [ "$(canonical_path "$candidate")" = "$plan" ]
}

for legacy in "$root/.j-flow/sdd/$slug" "$root/.superpowers/sdd/$slug"; do
  if matches_identity "$legacy"; then
    cd "$legacy" && pwd -P
    exit 0
  fi
done

digest=$(printf '%s' "$relative" | git hash-object --stdin)
base="$root/.j-flow/sdd"
dir="$base/$slug-${digest:0:12}"
if [ -f "$dir/progress.md" ] && ! matches_identity "$dir"; then
  echo "workspace journal belongs to another plan: $dir" >&2
  exit 2
fi
mkdir -p "$dir"
printf '*\n' > "$base/.gitignore"
cd "$dir" && pwd -P
